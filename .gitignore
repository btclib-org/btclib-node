.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   uv reads .python-version to pick the interpreter both locally and in
#   CI, so it is tracked here rather than ignored: an ignored file would
#   still work on a machine that already has one, and silently pick
#   whatever `uv run` falls back to everywhere else.

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
#Pipfile.lock

# PEP 582; used by e.g. github.com/David-OConnor/pyflow
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

