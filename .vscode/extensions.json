{
  // one entry per tool the lint gate already runs, so the editor reports
  // what .pre-commit-config.yaml would report at commit time. Nothing here
  // is a tool the gate does not have: an extension with no hook behind it
  // is a second opinion, and a finding no workflow enforces is noise.
  // Derived from this repository's own hooks, which are fewer than a
  // sibling's: there is no docs tree, no dependabot configuration and no
  // readthedocs file here, so the extensions those would justify are not
  // listed
  "recommendations": [
    // ruff-check and ruff-format
    "charliermarsh.ruff",
    // the local mypy hook, which runs the project environment's mypy
    "ms-python.mypy-type-checker",
    // the interpreter, the test explorer and the debugger under them
    "ms-python.python",
    "ms-python.debugpy",
    // the markdownlint-cli2 hook, reading this repository's own
    // .markdownlint.jsonc with no further configuration
    "DavidAnson.vscode-markdownlint",
    // the typos hook, the same tool as a language server, reading
    // [tool.typos] in pyproject.toml. There is no equivalent for codespell,
    // the other spell checker: what exists on the marketplace carries its
    // own dictionary rather than codespell's builtin, and a different
    // dictionary is a different set of findings
    "tekumara.typos-vscode",
    // check-yaml and the yamllint hook, which reads .yamllint.yaml: this
    // attaches both by filename, so what yamllint would report at commit
    // time is reported where the line is typed
    "redhat.vscode-yaml",
    // .github/workflows/claude-review.yml: expression and syntax checking
    // in the editor. This repository runs no actionlint hook, so unlike in
    // a sibling the extension is not a second reading of what a hook
    // already says -- it is the only thing that reads that file at all
    "github.vscode-github-actions",
    // the prettier hook, so what formats yaml and jsonc on save is the tool
    // that formats it at commit time and not the copy the yaml extension
    // embeds
    "esbenp.prettier-vscode",
    // check-toml, the pyproject.toml schema over it, and the taplo hook:
    // this extension *is* taplo, and it reads .taplo.toml
    "tamasfe.even-better-toml"
  ],
  // the reflex installs that would each fight a hook: ruff formats, and
  // ruff sorts the imports with "I". A second formatter on save reformats
  // what ruff-format just wrote, and the commit hook writes it back.
  // pylint is here for a different reason from the other three: this
  // repository's ruff `select` does not carry "PL", so pylint would not be
  // duplicating a hook but reporting findings nothing here enforces
  "unwantedRecommendations": [
    "ms-python.black-formatter",
    "ms-python.isort",
    "ms-python.flake8",
    "ms-python.pylint"
  ]
}
